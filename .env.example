# Goatz Studio Ortam Değişkenleri

# Admin panel şifresi (zorunlu)
ADMIN_PASSWORD=1544

# Sunucu portu (varsayılan: 5173)
PORT=5173

# PostgreSQL veritabanı bağlantı dizesi
# Railway'de otomatik olarak atanır
# Yerel geliştirme için: postgresql://user:password@localhost:5432/goatz
DATABASE_URL=postgresql://user:password@localhost:5432/goatz

# Node ortamı (production veya development)
NODE_ENV=development

# İletişim formundan gelen mesajları e-posta ile almak için (resend.com)
RESEND_API_KEY=
# Bildirimin gideceği adres (boşsa panelde İletişim'de yazılı e-posta kullanılır)
MAIL_TO=hello@thegoatzstudio.com
# Gönderen adres (alan adını Resend'de doğruladıktan sonra: The Goatz Studio <hello@thegoatzstudio.com>)
MAIL_FROM=

# Google Analytics 4 Ölçüm Kimliği (G-XXXXXXXXXX). Boşsa Analytics hiç yüklenmez. Ziyaretçi çerezleri "Kabul et" derse çalışır.
GA_MEASUREMENT_ID=
