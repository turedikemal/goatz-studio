# Goatz Studio Ortam Değişkenleri

# Admin panel şifresi (zorunlu)
ADMIN_PASSWORD=1544

# Sunucu portu (varsayılan: 5173)
PORT=5173

# PostgreSQL veritabanı bağlantı dizesi
# Railway'de otomatik olarak atanır
# Yerel geliştirme için: postgresql://user:password@localhost:5432/goatz
DATABASE_URL=postgresql://user:password@localhost:5432/goatz

# Node ortamı (production veya development)
NODE_ENV=development
